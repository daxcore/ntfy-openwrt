name: Bump ntfy version

on:
  schedule:
    - cron: "17 5 * * *"
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Get Latest Version
        id: ver
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          MAKEFILE=package/ntfy/Makefile
          LATEST=$(gh api repos/binwiederhier/ntfy/releases/latest --jq .tag_name | sed 's/^v//')
          CURRENT=$(sed -n 's/^PKG_VERSION:=\(.*\)/\1/p' "$MAKEFILE")
          echo "latest=$LATEST"   >> "$GITHUB_OUTPUT"
          echo "current=$CURRENT" >> "$GITHUB_OUTPUT"
          if [ "$LATEST" != "$CURRENT" ]; then
            echo "update=true" >> "$GITHUB_OUTPUT"
          fi

      - name: Update Makefile
        if: steps.ver.outputs.update == 'true'
        run: |
          MAKEFILE=package/ntfy/Makefile
          V=${{ steps.ver.outputs.latest }}
          curl -fsSL "https://github.com/binwiederhier/ntfy/archive/refs/tags/v${V}.tar.gz" -o src.tar.gz
          HASH=$(sha256sum src.tar.gz | cut -d' ' -f1)
          sed -i "s/^PKG_VERSION:=.*/PKG_VERSION:=${V}/" "$MAKEFILE"
          sed -i "s/^PKG_RELEASE:=.*/PKG_RELEASE:=1/"   "$MAKEFILE"
          sed -i "s/^PKG_HASH:=.*/PKG_HASH:=${HASH}/"   "$MAKEFILE"
          rm src.tar.gz

      - name: Create Pull Request
        if: steps.ver.outputs.update == 'true'
        uses: peter-evans/create-pull-request@v7
        with:
          #token: ${{ secrets.PAT_TOKEN }}
          branch: bump-ntfy-${{ steps.ver.outputs.latest }}
          commit-message: "ntfy: update to ${{ steps.ver.outputs.latest }}"
          title: "ntfy: Version bump to ${{ steps.ver.outputs.latest }}"
          body: "Automatic bump to latest ntfy v${{ steps.ver.outputs.latest }}."
